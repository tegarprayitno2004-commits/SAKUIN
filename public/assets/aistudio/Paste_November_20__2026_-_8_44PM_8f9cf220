FIREBASE SECURITY RULES (write firestore.rules and deploy them; NEVER use `allow read, write: if true`)
Implement rules equivalent to the following, and refine them to match the final schema. Validate types, required fields, positive amounts, and immutable ownership fields.

```
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function memberDoc(groupId) {
      return get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + uid()));
    }
    function isMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + uid()));
    }
    function isOwner(groupId) { return isMember(groupId) && memberDoc(groupId).data.role == 'owner'; }
    function perms(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.memberPermissions;
    }
    function validAmount(a) { return a is int && a > 0 && a <= 1000000000000; }

    match /users/{userId} {
      allow read, create, update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update: if isOwner(groupId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(groupId);
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update, delete: if signedIn() && resource.data.ownerId == uid();
    }

    match /groupMembers/{memberId} {
      allow read: if signedIn() && (resource.data.uid == uid() || isMember(resource.data.groupId));
      // Owner bootstraps own membership when creating the group (batched write)
      allow create: if signedIn() && request.resource.data.uid == uid() && (
        (request.resource.data.role == 'owner' &&
          getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == uid())
        ||
        (request.resource.data.role == 'member' &&
          get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.groupId == request.resource.data.groupId &&
          get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.active == true)
      );
      allow delete: if signedIn() && (resource.data.uid == uid() && resource.data.role == 'member' || isOwner(resource.data.groupId));
      allow update: if false;
    }

    match /transactions/{id} {
      allow read: if signedIn() && (
        (resource.data.scope == 'personal' && resource.data.ownerId == uid()) ||
        (resource.data.scope == 'group' && isMember(resource.data.groupId) &&
          (isOwner(resource.data.groupId) || resource.data.createdBy == uid() || perms(resource.data.groupId).canViewAllTransactions == true)));
      allow create: if signedIn() && request.resource.data.createdBy == uid() && validAmount(request.resource.data.amount) && (
        (request.resource.data.scope == 'personal' && request.resource.data.ownerId == uid()) ||
        (request.resource.data.scope == 'group' && isMember(request.resource.data.groupId) &&
          (isOwner(request.resource.data.groupId) || perms(request.resource.data.groupId).canAddTransactions == true)));
      allow update: if signedIn() && validAmount(request.resource.data.amount)
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy && (
        (resource.data.scope == 'personal' && resource.data.ownerId == uid()) ||
        (resource.data.scope == 'group' && (isOwner(resource.data.groupId) ||
          (resource.data.createdBy == uid() && perms(resource.data.groupId).canEditOwnTransactions == true))));
      allow delete: if signedIn() && (
        (resource.data.scope == 'personal' && resource.data.ownerId == uid()) ||
        (resource.data.scope == 'group' && (isOwner(resource.data.groupId) ||
          (resource.data.createdBy == uid() && perms(resource.data.groupId).canEditOwnTransactions == true))));
    }

    // budgets, categories, savingsGoals: same pattern. Personal: owner only.
    // Group: members read; only the group owner writes (budgets/categories); savingsGoals per owner decision.
    // notifications: read/create/update(isRead only)/delete only when userId == uid().
    // premiumSubscriptions/{userId}: read/write only when userId == uid() and simulated == true
    //   (document in README that real billing must be moved to a trusted server later).
  }
}
```
